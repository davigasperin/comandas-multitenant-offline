DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-bytes"
CORS_ORIGINS="http://localhost:3000"
PORT=3000
REDIS_URL="redis://localhost:6379"

# Opcional: cobrança Pix dinâmica por adaptador compatível.
PIX_PROVIDER="nome-do-provedor"
PIX_ADAPTER_URL="https://seu-adaptador.example.com"
PIX_ADAPTER_TOKEN=""
PIX_WEBHOOK_URL="https://api.example.com/v1/pix/webhooks/nome-do-provedor"
PIX_WEBHOOK_SECRET=""
# Segredo específico por provider (formato: PIX_WEBHOOK_SECRET_<PROVIDER_MAIUSCULO>)
# PIX_WEBHOOK_SECRET_NOME_DO_PROVEDOR=""
