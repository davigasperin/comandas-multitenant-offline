generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  password  String
  tenants   UserTenant[]
  refreshTokens RefreshToken[]
  createdAt DateTime     @default(now())
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  role        String
  logo_url    String?
  users       UserTenant[]
  products    Product[]
  orders      Order[]
  idempotency IdempotencyKey[]
  createdAt   DateTime     @default(now())
}

model UserTenant {
  userId    String
  tenantId  String
  role      String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([userId, tenantId])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  price_cents Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model Order {
  id          String               @id @default(cuid())
  tenantId    String
  table_label String
  status      String               @default("open")
  version     Int                  @default(1)
  opened_at   DateTime             @default(now())
  updated_at  DateTime             @default(now()) @updatedAt
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  history     OrderStatusHistory[]

  @@index([tenantId, status])
  @@index([tenantId, opened_at])
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  product_name     String
  quantity         Int
  unit_price_cents Int
  notes            String?
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id             String   @id @default(cuid())
  orderId        String
  from_status    String?
  to_status      String
  changed_by     String?
  changed_at     DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model IdempotencyKey {
  key         String
  tenantId    String
  response    String
  requestHash String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}
